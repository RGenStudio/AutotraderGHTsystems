# Dashboard env — copy to `.env.local` for local Next.js, or set in Vercel project settings.
# Never commit filled values. Never prefix the database password or service role with NEXT_PUBLIC_.

# Password gate (middleware). Leave empty for open local/dev access.
DASHBOARD_PASSWORD=

# Optional HMAC pepper for session cookies (defaults to DASHBOARD_PASSWORD).
DASHBOARD_SESSION_SECRET=

# Local preview only. On Vercel, sample trades are not shown when the database env is missing.
# Leave empty locally to see sample data. Set to anything other than demo to see the unconfigured state.
DASHBOARD_DATA_MODE=

# Server-only journal read. Prefer the Supabase *transaction* pooler (port 6543).
# Example shape (do not paste a real password into git):
# postgresql://postgres.[ref]:[PASSWORD]@aws-0-[region].pooler.supabase.com:6543/postgres?sslmode=require
# The Windows engine uses the session pooler on port 5432 in the repo-root .env — a different string.
DATABASE_URL=

# Alternative server-only read (used only when DATABASE_URL is empty).
# SUPABASE_URL is the project URL (https://[ref].supabase.co).
# SUPABASE_SERVICE_ROLE_KEY is the service_role secret. It bypasses RLS. Never NEXT_PUBLIC_.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Optional kill-switch JSON path for local demo mode (default: .data/kill-switch.json, /tmp on Vercel).
# Live mode reads kill_switch_state from Postgres and does not use this file.
# DASHBOARD_KILL_SWITCH_PATH=
