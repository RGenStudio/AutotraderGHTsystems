# Dashboard env — copy to `.env.local` for local Next.js, or set in Vercel project settings.
# Never commit filled values.

# Password gate (middleware). Leave empty for open local/dev access.
DASHBOARD_PASSWORD=

# Optional HMAC pepper for session cookies (defaults to DASHBOARD_PASSWORD).
DASHBOARD_SESSION_SECRET=

# Data source: demo (default, ships static JSON) | api (fetch ENGINE_JOURNAL_URL)
DASHBOARD_DATA_MODE=demo

# Optional HTTPS JSON feed when DASHBOARD_DATA_MODE=api (future Supabase/engine sync).
ENGINE_JOURNAL_URL=

# Optional kill-switch JSON path (default: .data/kill-switch.json local, /tmp on Vercel).
# DASHBOARD_KILL_SWITCH_PATH=
