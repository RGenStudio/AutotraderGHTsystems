# AutoTrader local secrets template — copy to `.env` on the Windows PC.
# Leave values empty here. Never commit a filled `.env`.

# Runtime mode: backtest | paper | live  (default / required for this phase: paper)
MODE=

# Exness MT5 (demo only in this phase) — Windows terminal path optional
MT5_LOGIN=
MT5_PASSWORD=
MT5_SERVER=
MT5_PATH=

# Telegram alerts
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# LLM providers (used via LLMClient only; optional until M5)
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
DEEPSEEK_API_KEY=
LLM_BASE_URL=

# Agent 2 economic calendar (structured feed URL)
NEWS_CALENDAR_URL=

# Persistence (SQLite URL for M0–M4; Postgres/Supabase later)
DATABASE_URL=
