# AutoTrader local secrets template — copy to `.env` on the Windows PC.
# Leave values empty here. Never commit a filled `.env`.

# Runtime mode: backtest | paper | live  (default / required for this phase: paper)
MODE=

# Exness MT5 (demo only in this phase) — Windows terminal path optional.
# Prefer forward slashes so ``\t`` is not parsed as a tab escape, e.g.:
# MT5_PATH=C:/Program Files/MetaTrader 5/terminal64.exe
# (Backslash form ``...\5\terminal64.exe`` can become ``...5erminal64.exe``.)
MT5_LOGIN=
MT5_PASSWORD=
MT5_SERVER=
MT5_PATH=

# Telegram alerts
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# LLM providers (via LLMClient only) — brief-aligned defaults:
#   Agent 1–2 deepseek-chat → DEEPSEEK_API_KEY
#   Agent 3   gpt-4o-mini   → OPENAI_API_KEY
#   Agent 4   claude-sonnet-4-5 → ANTHROPIC_API_KEY (native Messages API)
# Missing key for that agent's model → soft-fallback to mock (loop continues).
# Force all-mock: LLM_BACKEND=mock. LLM_BASE_URL optional override for OpenAI host only.
LLM_BACKEND=
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
DEEPSEEK_API_KEY=
LLM_BASE_URL=

# API credit low-alert → Telegram (orchestrator cycle / --loop).
# Default warn threshold = 1.0 USD when unset (also config api_credit.warn_usd).
# OpenAI often has no reliable remaining-balance API for standard keys — optional manual:
# OPENAI_CREDIT_USD=12.50
API_CREDIT_WARN_USD=
OPENAI_CREDIT_USD=

# Agent 2 economic calendar (structured feed URL)
NEWS_CALENDAR_URL=

# Persistence (SQLite WAL via SQLAlchemy; Postgres/Supabase later).
# Leave empty to use default file: data/autotrader.db (repo root).
# Example: DATABASE_URL=sqlite:///C:/path/to/autotrader/data/autotrader.db
DATABASE_URL=

# --- Ops dashboard (M7) — set in dashboard/.env.local or Vercel, not required for the Python engine ---
# See dashboard/.env.example for the full list.
# DASHBOARD_PASSWORD=
# DASHBOARD_DATA_MODE=demo

